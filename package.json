{
  "name": "mi-balance",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test:smoke": "node scripts/smoke.mjs",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace @mi-balance/api",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
