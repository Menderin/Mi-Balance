# Solo para API ejecutada fuera de Docker, con PostgreSQL local propio.
# Compose configura su red y DATABASE_URL explícitamente; no lee .env.local.
DATABASE_URL=postgresql://mi_balance:local_development_only@localhost:5432/mi_balance
PORT=3000
APP_ORIGIN=http://localhost:8080
# Ejemplo exclusivamente local. En producción generar un secreto aleatorio.
AUTH_SECRET=local-development-only-secret-do-not-use-in-production
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Mi Balance <no-reply@mi-balance.test>
